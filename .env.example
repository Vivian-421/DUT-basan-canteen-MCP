# Node 22.20+；本地可用HTTP，公网请设置自己的HTTPS地址。
HOST=127.0.0.1
PORT=3301
CANTEEN_MCP_PUBLIC_URL=http://localhost:3301
MONGO_URI=mongodb://127.0.0.1:27017/basan-canteen

# QQ邮箱SMTP授权码，不是QQ登录密码。留空时网页显示邮件未配置。
CANTEEN_SMTP_USER=
CANTEEN_SMTP_PASSWORD=
CANTEEN_SMTP_HOST=smtp.qq.com
CANTEEN_SMTP_PORT=465
CANTEEN_SMTP_SECURE=true

# stdio个人反馈文件；HTTP档案保存在同目录public/下。
CANTEEN_PREFERENCES_FILE=./data/canteen/preferences.json
# 留空使用仓库内置菜单快照。
CANTEEN_MENU_FILE=
